!(import! &self ../src/channels.py)
!(import! &self ../src/config.py)
!(import! &self ../src/helper.py)
!(import! &self ../src/plugin.py)
!(import! &self ../src/logger.py)
!(import! &self ../src/ona.py)
!(import! &self ./workbench_fixture.py)
!(import! &self ./src/utils)
!(import! &self ./src/config)
!(import! &self ./src/log)
!(import! &self ./src/plugin)
!(import! &self ./src/channels)
!(import! &self ./src/skills)
!(import! &self ./lib_nal)
!(import! &self ./lib_pln)
!(import! &self ./src/loop)
(= (commchannel) dashboard)
!(py-call (workbench_fixture.setup))
!(initLogger)
!(loadMettaPlugin "telos_goals" "./plugins/telos-goals")
!(loadMettaPlugin "ona" "./plugins/ona")
!(py-call (workbench_fixture.phase 1))
!(map-atom (1 2 3 4 5 6 7 8) $iteration (dashboard-process-control))
!(py-call (workbench_fixture.phase 2))
!(map-atom (1 2 3 4 5) $iteration (dashboard-process-control))
!(py-call (workbench_fixture.phase 3))
!(dashboard-process-control)
!(py-call (workbench_fixture.phase 4))
