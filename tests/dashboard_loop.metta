; Exercise the actual Omega loop with deterministic Python channel/provider.
; From the Omega root: sh "$PETTA_PATH/run.sh" tests/dashboard_loop.metta
!(import! &self ../src/channels.py)
!(import! &self ../src/providers.py)
!(import! &self ../src/utils.py)
!(import! &self ../src/helper.py)
!(import! &self ./dashboard_loop_fixture.py)
!(import! &self ./src/utils)
!(import! &self ./src/providers)
!(import! &self ./src/channels)
!(import! &self ./src/loop)

; Isolate initialization, memory, clock delays, and provider configuration;
; the production receive/provider/tool execution/end-of-turn path is unchanged.
(= (commchannel) dashboard)
(= (maxNewInputLoops) 5)
(= (maxWakeLoops) 0)
(= (sleepInterval) 0)
(= (wakeupInterval) 600)
(= (provider) Fixture)
(= (memoryDirectory) "/tmp")
(= (maxOutputToken) 100)
(= (reasoningMode) low)
(= (maxFeedback) 12000)
(= (getPrompt $provider) "Deterministic fixture")
(= (getSkills) (quote ((send "Send a reply" (content)))))
(= (getSkillRules) "")
(= (getHistory) "")
(= (addToHistory $message $calls $new) True)
(= (log $level $module $message) True)
(= (py-str $value) (py-call (str $value)))
(= (heartbeat $iteration)
   (progn (py-call (dashboard_loop_fixture.heartbeat $iteration))
          (if (> $iteration 5) (translatePredicate (halt 0)) True)))

!(py-call (dashboard_loop_fixture.setup))
!(change-state! &prevmsg "")
!(change-state! &loops 5)
!(change-state! &nextWakeAt 999999999999)
!(messagesClear)
!(omega 2)
